{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "letterboxd-connect/movie-grid",
	"title": "Movie Grid",
	"category": "widgets",
	"icon": "video-alt2",
	"description": "Movies from your Letterboxd diary, as a grid of posters or a list.",
	"keywords": [ "letterboxd", "movies", "films", "diary" ],
	"textdomain": "letterboxd-connect",
	"attributes": {
		"number": { "type": "number", "default": 12 },
		"showAll": { "type": "boolean", "default": false },
		"perPage": { "type": "number", "default": 12 },
		"orderby": { "type": "string", "enum": [ "watch_date", "title", "release_year" ], "default": "watch_date" },
		"order": { "type": "string", "enum": [ "DESC", "ASC" ], "default": "DESC" },
		"columns": { "type": "number", "default": 3 },
		"displayMode": { "type": "string", "enum": [ "cards", "list" ], "default": "cards" },
		"showDirector": { "type": "boolean", "default": true },
		"showRating": { "type": "boolean", "default": true },
		"showStreamingLink": { "type": "boolean", "default": true },
		"showExternalLinks": { "type": "boolean", "default": true }
	},
	"supports": { "html": false, "align": [ "wide", "full" ] },
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php"
}
